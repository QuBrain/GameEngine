<Project>
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SkipResolvePackageAssets>true</SkipResolvePackageAssets>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>




    <ManagedDir>$(GameDir)\NuclearOption_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx\core</BepInExDir>
    <PublicizedDir>$(MSBuildThisFileDirectory)..\lib\publicized</PublicizedDir>
  </PropertyGroup>

  <!-- Automatic References for 100% IDE Autocomplete & IntelliSense -->
  <ItemGroup>
    <!-- Publicized Assembly-CSharp for full private & internal member access -->
    <Reference Include="Assembly-CSharp" Condition="Exists('$(PublicizedDir)\Assembly-CSharp.dll')">
      <HintPath>$(PublicizedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp" Condition="!Exists('$(PublicizedDir)\Assembly-CSharp.dll') and Exists('$(ManagedDir)\Assembly-CSharp.dll')">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- BepInEx and Harmony Core -->
    <Reference Include="0Harmony" Condition="Exists('$(BepInExDir)\0Harmony.dll')">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx" Condition="Exists('$(BepInExDir)\BepInEx.dll')">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity Engine Modules -->
    <Reference Include="UnityEngine" Condition="Exists('$(ManagedDir)\UnityEngine.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule" Condition="Exists('$(ManagedDir)\UnityEngine.PhysicsModule.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI" Condition="Exists('$(ManagedDir)\UnityEngine.UI.dll')">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Multiplayer & Networking -->
    <Reference Include="Mirage" Condition="Exists('$(ManagedDir)\Mirage.dll')">
      <HintPath>$(ManagedDir)\Mirage.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirage.Components" Condition="Exists('$(ManagedDir)\Mirage.Components.dll')">
      <HintPath>$(ManagedDir)\Mirage.Components.dll</HintPath>
      <Private>false</Private>
    </Reference>

  </ItemGroup>
</Project>
