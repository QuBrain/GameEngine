      "        private Harmony _harmony;",
      "",
      "        private void Awake()",
      "        {",
      "            Logger = base.Logger;",
      "            _harmony = new Harmony(MOD_GUID);",
      "            _harmony.PatchAll();",
      "            Logger.LogInfo($\"{MOD_NAME} v{MOD_VERSION} initialized successfully.\");",
      "        }",
      "",
      "        private void OnDestroy()",
      "        {",
      "            _harmony?.UnpatchSelf();",
      "        }",
      "    }",
      "}"
